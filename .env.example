# Docker Compose configuration.
# Copy this file to .env in the project root and edit values as needed.

IMAGE_TAG=latest
BACKEND_IMAGE=ghcr.io/glintechnology/bomtool-backend
FRONTEND_IMAGE=ghcr.io/glintechnology/bomtool-frontend

POSTGRES_USER=glintech
POSTGRES_PASSWORD=glintech
POSTGRES_DB=glintech
POSTGRES_PORT=5432

HTTP_PORT=80
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/uploads

# Official supplier API pricing.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
DIGIKEY_ENV=sandbox
MOUSER_API_KEY=
TI_CLIENT_ID=
TI_CLIENT_SECRET=
SUPPLIER_API_TIMEOUT_SECONDS=20
SUPPLIER_API_MAX_RETRIES=2
SUPPLIER_API_MOCK=false
SUPPLIER_API_MOCK_ALLOW_EXPORT=false
